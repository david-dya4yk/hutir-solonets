{
  "name": "hutir-solonets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings=0",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run css:types && next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run format:check",
    "css:types": "tcm src --pattern \"**/*.module.css\" --silent",
    "predev": "npm run css:types",
    "prebuild": "npm run css:types"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "typed-css-modules": "^0.9.1",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "typescript-plugin-css-modules": "^5.2.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
